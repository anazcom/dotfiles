#!/usr/bin/env bash
set -euo pipefail

# DEVC_SSH_AUTH_SOCK: SSH Auth Socket to be used

: "${DEVC_DOTFILES:=https://github.com/anazcom/dotfiles}"
: "${DEVC_SHELL:=}"
: "${DEVC_SSH_AGENT:=1}"

AGENT_TARGET=/ssh-agent

log() { printf 'devc: %s\n' "$*" >&2; }
die() {
    log "$*"
    exit 1
}
needs() { command -v "$1" >/dev/null || die "$1 not found${2:+ ($2)}"; }

main() {
    local cmd=${1:-}
    if (($#)); then shift; fi
    case $cmd in
    -h | --help)
        usage
        exit 0
        ;;
    up | enter | down | delete) ;;
    *) die "Unknown command: $cmd." "Please check help [devc --help]" ;;
    esac

    needs docker
    needs devcontainer "npm i -g @devcontainers/cli"
    "cmd_$cmd" "$@"
}

usage() {
    cat <<EOF
devc up [options] -- [extra-options]
devc down [options] -- [extra-options] 
devc exec
devc -h|--help
EOF
}

cmd_up() {
    DIR=""
    ID=""
    RECREATE=0
    CLI=()

    while (($#)); do
        case $1 in
        -i | --id)
            (($# >= 2)) || die "Missing value for $1"
            ID=$2
            shift
            ;;
        -d | --dotfiles)
            (($# >= 2)) || die "Missing value for $1"
            DEVC_DOTFILES=$2
            shift
            ;;
        -r | --recreate)
            RECREATE=1
            ;;
        -*) die "Unknown option: $1" ;;
        *) DIR=$1 ;;
        esac
        shift
    done

    DIR=$(cd "${DIR:-$PWD}" && pwd)
    [[ -n $DEVC_DOTFILES ]] && CLI+=(--dotfiles-repository "$DEVC_DOTFILES")
    [[ -n $DIR ]] && CLI+=(--workspace-folder "$DIR")
    [[ -n $ID ]] && CLI+=(--id-label "id=$ID")
    [[ -n $RECREATE ]] && CLI+=(--remove-existing-container)
    if [[ -n $DEVC_SSH_AGENT ]]; then
        AGENT_SRC=$(resolve_agent)
        if [[ -n $AGENT_SRC ]]; then
            CLI+=(--mount "type=bind,source=$AGENT_SRC,target=$AGENT_TARGET")
            CLI+=(--remote-env "SSH_AUTH_SOCK=$AGENT_TARGET")
        else
            log "No ssh-agent found on the host; add to your shell 'eval \$\"(ssh-agent -s)\"'"
        fi
    fi

    devcontainer up --log-level trace "${CLI[@]}"

    # Only Darwin's socket is a root-owned Docker Desktop VM proxy; on Linux
    # AGENT_SRC is the user's real host ssh-agent socket, already accessible.
    if [[ $(uname -s) == Darwin && -n $DEVC_SSH_AGENT && -n ${AGENT_SRC:-} ]]; then
        if ! devcontainer exec --workspace-folder "$DIR" bash -c \
            "sudo -n chmod 666 '$AGENT_TARGET' 2>/dev/null || chmod 666 '$AGENT_TARGET'"; then
            log "Could not relax permissions on $AGENT_TARGET; ssh-agent forwarding may not work inside the container"
        fi
    fi
}

cmd_enter() {
    while (($#)); do
        case $1 in
        -s | --shell)
            (($# >= 2)) || die "Missing value for $1"
            SHELL=$2
            shift
            ;;
        *) DIR=$1 ;;
        esac
        shift
    done
    DIR=$(cd "${DIR:-$PWD}" && pwd)
    CLI=(--workspace-folder "$DIR")
    if [[ -n $DEVC_SSH_AGENT ]]; then
        CLI+=(--remote-env "SSH_AUTH_SOCK=$AGENT_TARGET")
    fi

    devcontainer exec --log-level debug "${CLI[@]}" $SHELL -l
}

main_container() { docker ps -aq --filter "label=devcontainer.local_folder=$1" | head -n1; }
compose_project() {
    docker inspect -f '{{with index .Config.Labels "com.docker.compose.project"}}{{.}}{{end}}' "$1"
}

cmd_down() {
    DIR=$(cd "${1:-$PWD}" && pwd)
    CLI=()
    ID=$(main_container "$DIR") || return 0
    PROJECT=$(compose_project "$ID")

    if [[ -n $PROJECT ]]; then
        docker compose -p "$PROJECT" stop >&2
    else
        docker stop "$ID" >/dev/null
    fi
}

cmd_delete() {
    DIR=$(cd "${1:-$PWD}" && pwd)
    CLI=()
    ID=$(main_container "$DIR") || return 0
    PROJECT=$(compose_project "$ID")

    if [[ -n $PROJECT ]]; then
        docker compose -p "$PROJECT" down >&2
    else
        docker rm -f "$ID" >/dev/null
    fi
}

resolve_agent() {
    if [[ -n ${DEVC_SSH_AUTH_SOCK:-} ]]; then
        printf '%s\n' "$DEVC_SSH_AUTH_SOCK"
    elif [[ $(uname -s) == Darwin ]]; then
        echo "/run/host-services/ssh-auth.sock"
    elif [[ -S ${SSH_AUTH_SOCK:-} ]]; then
        printf '%s\n' "$SSH_AUTH_SOCK"
    fi
}

main "$@"
