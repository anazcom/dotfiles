#!/usr/bin/env bash
set -euo pipefail

: "${TMS_SEARCH_PATHS:=$HOME/repos $HOME/repos/work $HOME/repos/work/lab $HOME/repos/personal $HOME/repos/personal/lab $HOME/.config}"
: "${TMS_DEPTH:=1}"
: "${TMS_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/tms}"
: "${TMS_SSH_EXCLUDE:=github.com gitlab.com}"

die() {
    echo "tms: $*" >&2
    exit 1
}
sanitize() { basename -- "$1" | tr '.: ' '___'; }

usage() {
    cat <<EOF
tms — tmux sessionizer with multiple modes

Usage: tms <command> [args]

Commands:
  [dir]          Folder session, classic sessionizer (default: fzf picker over \$TMS_SEARCH_PATHS)
  ssh   [host]   Every pane/window in the session ssh's into host (default: fzf picker over ~/.ssh/config)
  dc    [dir]    Bring up the devcontainer (devc up); every pane/window lands inside it (devc enter)

Env:
  TMS_SEARCH_PATHS  Dirs to search for folder/devcontainer sessions
                    (default: $TMS_SEARCH_PATHS)
  TMS_DEPTH         Max search depth under each search path (default: $TMS_DEPTH)
  TMS_SSH_EXCLUDE   Space separated ssh hosts hidden from the picker
                    (default: $TMS_SSH_EXCLUDE)

tms -h | --help     Show this help
EOF
}

pick_dir() {
    find $TMS_SEARCH_PATHS -mindepth 1 -maxdepth "$TMS_DEPTH" -type d 2>/dev/null |
        fzf --prompt='dir> '
}

pick_host() {
    local files=("$HOME/.ssh/config")
    # Include all files from config.d if found
    [[ -d $HOME/.ssh/config.d ]] && files+=("$HOME/.ssh/config.d/*")
    # Get all values from each line that start with HOST wihout including
    # special characters !wep-app *.github.com
    awk 'tolower($1)=="host" { for (i=2;i<=NF;i++) if ($i !~ /[*?!]/) print $i }' \
        "${files[@]}" 2>/dev/null | sort -u |
        while IFS= read -r h; do
            local skip=0 ex
            for ex in $TMS_SSH_EXCLUDE; do
                [[ $h == "$ex" ]] && skip=1 && break
            done
            ((skip)) || printf '%s\n' "$h"
        done | fzf --prompt='ssh> '
}

pick_devcontainer() {
    find $TMS_SEARCH_PATHS -mindepth 1 -maxdepth "$TMS_DEPTH" -type d 2>/dev/null |
        while IFS= read -r d; do
            [[ -d "$d/.devcontainer" || -f "$d/.devcontainer.json" ]] && printf '%s\n' "$d"
        done |
        fzf --prompt='devcontainer> '
}

open_session() {
    local name=$1 dir=$2 cmd=${3:-}
    if ! tmux has-session -t "=$name" 2>/dev/null; then
        tmux new-session -ds "$name" -c "$dir"
        if [[ -n $cmd ]]; then
            tmux set-option -t "$name" default-command "$cmd"
            tmux respawn-pane -k -t "$name" "$cmd"
        fi
    fi
    if [[ -n ${TMUX:-} ]]; then
        tmux switch-client -t "=$name"
    else
        tmux attach-session -t "=$name"
    fi
}

cmd_dir() {
    local dir=${1:-$(pick_dir)}
    [[ -n $dir ]] || exit 0
    dir=$(cd "$dir" && pwd)
    open_session "$(sanitize "$dir")" "$dir"
}

cmd_ssh() {
    local host=${1:-$(pick_host)}
    [[ -n $host ]] || exit 0
    open_session "ssh_$(sanitize "$host")" "$HOME" "ssh $host"
}

cmd_dc() {
    local dir=${1:-$(pick_devcontainer)}
    [[ -n $dir ]] || exit 0
    dir=$(cd "$dir" && pwd)
    devc up "$dir"
    open_session "dc_$(sanitize "$dir")" "$dir" "devc enter $dir"
}

case ${1:-} in
ssh)
    shift
    cmd_ssh "$@"
    ;;
dir)
    shift
    cmd_dir "$@"
    ;;
dc)
    shift
    cmd_dc "$@"
    ;;
-h | --help) usage ;;
*) exit 0 ;;
esac
